# Copy to .env and fill in what you need. Nothing here is read directly by
# name from Go code except where noted -- config.yaml points at most of
# these indirectly (redis.password_env, postgres.dsn_env,
# providers[].api_key_env), so the *names* below are this repo's own
# convention (matching deploy/config.yaml and README.md's example config),
# not something hardcoded in internal/config.

# Required if you configure a real "openai"-type provider (providers[].type:
# openai in config.yaml) -- see providers[].api_key_env.
OPENAI_API_KEY=

# Required if you configure a real "anthropic"-type provider.
ANTHROPIC_API_KEY=

# Required: Postgres connection string. deploy/config.yaml sets
# postgres.dsn_env to this name; docker-compose already wires it to the
# postgres service for you.
POSTGRES_DSN=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable

# Optional: only needed if redis.password_env is set in your config.yaml
# and your Redis actually requires a password (deploy/config.yaml's Redis
# doesn't).
# REDIS_PASSWORD=

# Semantic cache (cache.semantic in config.yaml). Only needed if you're
# running the gateway natively rather than via the Dockerfile, which
# fetches and sets these itself at build time -- see docs/adr/0012.
# ONNXRUNTIME_LIB_PATH=
# EMBEDDING_MODEL_PATH=
# EMBEDDING_VOCAB_PATH=

# Optional: where the semantic cache's persisted HNSW index lives if
# cache.semantic.persist_path isn't set in config.yaml. Defaults to
# ./semantic_cache.gob.
# SEMANTIC_CACHE_PERSIST_PATH=

# Only used by `go test`, for internal/ratelimit and internal/cache/exact's
# tests that exercise a real Redis (see docs/adr/0002's testing note).
# Leave unset and those tests self-skip.
# RATELIMIT_TEST_REDIS_ADDR=localhost:6379
