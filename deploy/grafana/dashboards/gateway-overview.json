{
  "title": "LLM Inference Gateway",
  "uid": "gateway-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Cache hit rate by tier",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (tier) (rate(gateway_cache_hits_total[5m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tokens saved (rate)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(gateway_tokens_saved_total[5m])",
          "legendFormat": "tokens saved/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cost burn rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(gateway_cost_usd_total[5m]) * 3600",
          "legendFormat": "$/hour",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Breaker state per provider",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "custom": { "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "gateway_breaker_state",
          "legendFormat": "{{provider}} (0=closed 1=half-open 2=open)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Proxy overhead p50/p95/p99",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(gateway_proxy_overhead_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(gateway_proxy_overhead_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(gateway_proxy_overhead_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rate-limit rejections by scope",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (scope) (rate(gateway_ratelimit_rejections_total[5m]))",
          "legendFormat": "{{scope}}",
          "refId": "A"
        }
      ]
    }
  ]
}
